# Copia este archivo a ".env.local" (ese sí lo lee Next.js) y complétalo.
# ".env.local" nunca se sube al repositorio (ver .gitignore).

# Opcional. Sin esto, el conector de GitHub funciona igual pero con el límite
# público de 60 peticiones/hora. Con un token gratuito (Settings > Developer
# settings > Personal access tokens > Fine-grained, sin permisos especiales)
# el límite sube a 5000/hora y además habilita la stat de "racha" (requiere
# la API GraphQL, que exige autenticación incluso para datos públicos).
GITHUB_TOKEN=

# Supabase — guardar y compartir tarjetas (link /c/<slug>).
# Dashboard de Supabase > Project Settings > API.
# Ambas son PÚBLICAS por diseño (van al navegador); el acceso lo controla
# Row Level Security. NUNCA pongas aquí la service_role / "secret" key.
# Aplica el esquema una vez: SQL Editor > pega supabase/schema.sql > Run.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Opcional. Dominio final del sitio, para que las imágenes de preview de los
# links compartidos apunten bien. En Vercel se detecta solo; en local no hace
# falta. Ej: https://identika.app
NEXT_PUBLIC_SITE_URL=
